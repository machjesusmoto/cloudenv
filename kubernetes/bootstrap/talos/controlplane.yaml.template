# Talos Control Plane Machine Configuration Template
# Reference: https://www.talos.dev/v1.9/reference/configuration/
#
# DO NOT EDIT THIS FILE DIRECTLY - Use patches for node-specific values
# This template is used by generate-configs.sh with talosctl gen config
#
# Usage:
#   talosctl gen config cloudenv-k8s https://10.9.8.100:6443 \
#     --with-secrets secrets.yaml \
#     --config-patch @patches/common.yaml \
#     --output-dir ./generated

version: v1alpha1
debug: false
persist: true

machine:
  type: controlplane

  certSANs:
    - "10.9.8.100"           # VIP
    - "10.9.8.11"            # Node 1
    - "10.9.8.12"            # Node 2
    - "10.9.8.13"            # Node 3
    - "cloudenv-k8s"         # Cluster name

  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.31.4
    extraArgs:
      rotate-server-certificates: "true"
    defaultRuntimeSeccompProfileEnabled: true

  network:
    nameservers:
      - 10.9.8.1                 # Gateway DNS
      - 1.1.1.1                  # Cloudflare fallback

  install:
    disk: /dev/sda
    image: ghcr.io/siderolabs/installer:v1.9.1
    bootloader: true
    wipe: false
    extensions:
      - image: ghcr.io/siderolabs/qemu-guest-agent:v1.9.1

  features:
    rbac: true
    stableHostname: true
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:reader
      allowedKubernetesNamespaces:
        - kube-system

cluster:
  controlPlane:
    endpoint: https://10.9.8.100:6443    # VIP endpoint

  clusterName: cloudenv-k8s

  network:
    cni:
      name: none                         # Cilium installed separately
    dnsDomain: cluster.local
    podSubnets:
      - 10.244.0.0/16
    serviceSubnets:
      - 10.96.0.0/12

  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.31.4
    certSANs:
      - "10.9.8.100"
    extraArgs:
      anonymous-auth: "false"
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1
          kind: PodSecurityConfiguration
          defaults:
            enforce: baseline
            enforce-version: latest
            warn: restricted
            warn-version: latest
            audit: restricted
            audit-version: latest
          exemptions:
            namespaces:
              - kube-system
              - democratic-csi
              - argocd

  controllerManager:
    image: registry.k8s.io/kube-controller-manager:v1.31.4

  scheduler:
    image: registry.k8s.io/kube-scheduler:v1.31.4

  proxy:
    disabled: true                       # Cilium replaces kube-proxy

  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
